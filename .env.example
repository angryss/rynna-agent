# Default local Ollama configuration
RYNNA_API_BASE=http://127.0.0.1:11434/v1
RYNNA_MODEL=qwen3:8b

# Optional absolute path when not using the platform config directory.
# RYNNA_CONFIG=/etc/rynna/config.yaml
# Optional process default; otherwise the catalog's default_profile is used.
# RYNNA_PROFILE=work

# Set only in your shell, service manager, or secret store when required.
# Credentials require HTTPS except for local loopback development endpoints.
# RYNNA_API_KEY=
# OpenRouter API billing; reference this name with api_key_env.
# OPENROUTER_API_KEY=
# Direct Anthropic Messages API billing; reference this name with api_key_env.
# ANTHROPIC_API_KEY=
# Optional Claude Code executable used by CLI/web/desktop provider sign-in.
# For profile execution, set providers.<name>.claude_program in the YAML catalog.
# RYNNA_CLAUDE_PATH=/usr/local/bin/claude
# Optional setup-token credential. Subscription mode preserves this variable but
# removes competing API, profile, gateway, and cloud-provider overrides.
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional trusted instruction.
# RYNNA_SYSTEM_PROMPT=You are Rynna, a careful and capable AI software agent.

# Optional Rust diagnostics.
RUST_LOG=warn

# A separate browser/API origin requires CORS at a trusted reverse proxy.
# VITE_RYNNA_API_URL=http://127.0.0.1:3000
