{
  "name": "rynna",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/ui"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @rynna/web",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "web:dev": "npm run dev --workspace @rynna/web",
    "web:build": "npm run build --workspace @rynna/web",
    "desktop:dev": "npm run tauri:dev --workspace @rynna/desktop",
    "desktop:build": "npm run tauri:build --workspace @rynna/desktop"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
